// Wall Clock resources

// The first icon is the one Windows shows for the program
wall_clock ICON "icons/wall_clock.ico"

// wxWidgets resources, including the common controls v6 and per-monitor
// DPI aware manifest
#define wxUSE_RC_MANIFEST 1
#define wxUSE_DPI_AWARE_MANIFEST 2
#include "wx/msw/wx.rc"

1 VERSIONINFO
FILEVERSION     2,4,0,0
PRODUCTVERSION  2,4,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DataReel Software Development"
      VALUE "FileDescription", "Wall Clock"
      VALUE "FileVersion", "2.4"
      VALUE "InternalName", "wall_clock"
      VALUE "OriginalFilename", "wall_clock.exe"
      VALUE "ProductName", "Wall Clock"
      VALUE "ProductVersion", "2.4"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
